{
    "name": "jimdo/testdatabuilder",
    "description": "Helps you to build your mocks, stubs and test data in a nice oop way.",
    "keywords": ["test","testing","mock","mocking"],
    "homepage": "https://github.com/jimdo/TestDataBuilder",
    "license": "LGPL",
    "require": {
        "php" : ">7.1",
        "phpunit/phpunit": "6.*"
    },
    "autoload": {
        "exclude-from-classmap": ["/tests/"],
        "psr-4": { "TestDataBuilder\\": "src/" }
    }
}
